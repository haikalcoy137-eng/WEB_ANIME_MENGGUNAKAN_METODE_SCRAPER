# Frontend configuration (copy ke .env.local bila perlu)

# Base URL API backend.
# - Kosong / "/api"  -> pakai proxy dev server Vite (lihat vite.config.js) => default saat development
# - Isi absolut      -> dipakai langsung oleh browser (butuh CORS di backend, backend sudah mengaktifkannya)
# Contoh produksi:
# VITE_API_BASE_URL=https://otakudesu-api-jade.vercel.app/api
VITE_API_BASE_URL=/api

# Target backend Express untuk proxy dev server (hanya dipakai saat `npm run dev` / `npm run preview`)
VITE_DEV_API_TARGET=http://localhost:3000
